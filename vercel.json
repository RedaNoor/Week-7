{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/py/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "functions": {
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "backend/data/**",
      "excludeFiles": "{backend/data/ml_prediction_log.jsonl,**/__pycache__/**,**/*.pyc,scripts/**,.notebook/**,.pytest_cache/**,.git/**,node_modules/**,.next/**,dataset_properties.csv}"
    }
  }
}
