# Frontend (Next.js) environment variables
# Copy to .env.local and fill in.

# Public API key — exposed to the browser. Must match the backend's
# API_KEY. When REQUIRE_AUTH=false on the backend, this can be empty.
NEXT_PUBLIC_API_KEY=

# Backend URL — used by the Next.js API proxy route (server-side only).
# Do NOT prefix with NEXT_PUBLIC_ — this should stay server-side.
BACKEND_URL=http://localhost:8000
