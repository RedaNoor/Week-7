# ==========================================================================
# Real Estate Voice Agent — environment configuration
# ==========================================================================
# Copy this file to `.env` and fill in the values for your deployment.
# All values are required unless marked as optional.

# ----- Application -----
APP_NAME=real_estate_voice_agent
APP_ENV=development                  # development | staging | production
LOG_LEVEL=INFO                        # DEBUG | INFO | WARNING | ERROR
ML_MODEL_BUNDLE_PATH=backend/data/week8/models/model_bundle.joblib
ML_REQUIRE_ARTIFACT=false              # set true in production
ML_MAX_BATCH_ROWS=1000

# ----- Voice and model providers -----
VAPI_API_KEY=your_vapi_api_key
DEEPGRAM_API_KEY=your_deepgram_api_key
OPENAI_API_KEY=your_openai_api_key
OPENROUTER_API_KEY=your_openrouter_api_key

# Public URL used by telephony webhooks (Vapi/Twilio call this back)
BASE_URL=https://your-tunnel-url.trycloudflare.com

# ----- Database (PostgreSQL) -----
# Use the format: postgresql://user:password@host:port/dbname?sslmode=require
DATABASE_URL=postgresql://username:password@localhost:5432/real_estate_voice
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100

# ----- Telephony (Twilio) -----
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token        # used to verify webhook signatures
TWILIO_PHONE_NUMBER=+12345678901

# ----- Calendar integration (optional) -----
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
GOOGLE_CALENDAR_ID=primary

# ----- SMTP (email) -----
# For Gmail, generate an "App Password" at https://myaccount.google.com/apppasswords
# and use that here (NOT your regular Gmail password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465                         # 465 for SSL, 587 for STARTTLS
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password        # 16-character Gmail App Password
SMTP_FROM=your_email@gmail.com
DEFAULT_RECIPIENT_EMAIL=your_email@gmail.com
SENDER_NAME=Real Estate Hub Sales Team

# Optional allow-list of recipients (comma-separated). If set, the email
# service will only deliver to addresses on this list — strongly recommended
# in production to prevent the booking endpoint being used as an open relay.
# ALLOWED_RECIPIENTS=founder@example.com,agent1@example.com,agent2@example.com

# ----- n8n workflow automation (optional) -----
N8N_BASE_URL=http://localhost:5678/webhook
USE_MASTER_N8N_WORKFLOW=true

# ----- Security -----
# Set REQUIRE_AUTH=true in production. When true, all sensitive endpoints
# require a valid X-API-Key header. When false (dev), requests are allowed
# through without a key (a warning is logged).
REQUIRE_AUTH=false

# API key for read/write endpoints (chat, booking, lead analysis, etc.)
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change_me_to_a_long_random_string

# Admin API key for mutating/admin endpoints (learn, retrain, rate-limit reset)
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=change_me_to_a_different_long_random_string

# Trusted CORS origins (comma-separated). The website URL must be here.
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000
